ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>

# Optional: Override default LLM models (default: gpt-4.1)
# TAU2_LLM_AGENT=claude-haiku-4-5-20251001
# TAU2_LLM_USER=claude-haiku-4-5-20251001

# ============== SLIME Integration Settings ==============
# Domain and task settings
TAU2_DOMAIN=telecom
TAU2_TASK_SPLIT=train
TAU2_USER_LLM=claude-haiku-4-5
TAU2_USER_TEMP=0.0
TAU2_MAX_STEPS=100

# Tool parsing (qwen, llama3)
TAU2_TOOL_PARSER=qwen
TAU2_MODEL_TYPE=qwen3

# Response settings
TAU2_MAX_RESPONSE_TOKENS=1024
TAU2_REFORMULATE_TOOL_INSTRUCTION=false

# Optional: Log probability collection for TIS metrics
TAU2_RETURN_LOGPROB=false

# Optional: Solo mode (no user simulation)
TAU2_SOLO_MODE=false
